# Azure AD App (Microsoft Entra ID)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-secret

# Mailbox alvo (Outlook / Microsoft 365)
OUTLOOK_USER_EMAIL=seu.email@empresa.com

# Quantidade de emails não lidos para analisar por execução
FETCH_TOP=10

# Opcional: Webhook de canal Teams para receber relatório
TEAMS_WEBHOOK_URL=

# Opcional: caminho de saída em JSON
REPORT_OUTPUT=outlook_report.json

# Opcional: habilitar envio também por WhatsApp (Twilio)
ENABLE_WHATSAPP_REPORT=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TO=+5511999999999
